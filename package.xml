  <version>0.1.0</version>
  <description>This package provides all olive custom interfaces</description>
  <maintainer email="samuel@olive-robotics.com">Samuel Hafner</maintainer>
  <license>Apache License 2.0</license>

  <url type="website">https://www.olive-robotics.com/</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>geometry_msgs</buildtool_depend>
  
